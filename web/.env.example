# Copy to .env.production and fill in to enable Google Analytics (GA4) in the build.
# Without it, the site has no cookie banner and loads nothing from Google.
VITE_GA_ID=

# Games enabled on the site (feature flag), comma separated: firered, leafgreen, ruby, sapphire, emerald.
# Default: FireRed and LeafGreen. Today it enables each game's theme.
VITE_GAMES=
