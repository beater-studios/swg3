# Install fails on a Node version outside "engines" (package.json); the development version is in .nvmrc.
engine-strict=true
# No dependency needs install scripts today; blocking them protects against a compromised package.
ignore-scripts=true
fund=false
# New dependencies are saved at an exact version, like the existing ones; updates are deliberate.
save-exact=true
# Only versions published at least 7 days ago: time for a compromised release to be caught and pulled.
min-release-age=7
